    {
      "name": "Create booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains a bookingid\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.bookingid).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Saved data matches what was sent\", function () {\r\n    const booking = pm.response.json().booking;\r\n    pm.expect(booking.firstname).to.eql(\"Asha\");\r\n    pm.expect(booking.lastname).to.eql(\"Rao\");\r\n    pm.expect(booking.totalprice).to.eql(150);\r\n    pm.expect(booking.depositpaid).to.eql(true);\r\n});\r\n\r\nconst newId = pm.response.json().bookingid;\r\npm.environment.set(\"bookingId\", newId);"
            ]
          }
        }
      ],
